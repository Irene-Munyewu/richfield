# Copy this file to .env and fill in real values. .env is gitignored.
# These two are safe to be client-side — Supabase's anon key relies on
# RLS policies for security, not secrecy.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER add a Gemini key here. It must only exist as a Supabase Edge
# Function secret (`supabase secrets set GEMINI_API_KEY=...`), so it's
# never bundled into the client app.
